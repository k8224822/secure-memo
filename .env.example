# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 절대 git 에 올리지 않기)
#   cp .env.example .env
#
# 비밀값 생성:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ─────────────────────────────────────────────────────────────

# ── MariaDB (db 컨테이너) ──
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=secure_memo
MARIADB_USER=memo_app
MARIADB_PASSWORD=
# DB_HOST 는 docker-compose.yml 에서 서비스명 "db" 로 고정

# ── Flask 비밀키 (각각 32자 이상, 서로 다르게) ──
JWT_SECRET_KEY=
CSRF_SECRET_KEY=

# ── JWT / 재전송 방어 ──
ACCESS_TOKEN_MINUTES=15
REPLAY_WINDOW_SECONDS=30

# ── 쿠키 ──
# 지금 구성은 http(80) 이므로 false. 앞단에 HTTPS 를 붙이면 true 로 변경
COOKIE_SECURE=false
# 접속 주소가 정해져 있다면 적어두기 (쉼표로 여러 개, 비우면 요청 Host 기준)
# TRUSTED_ORIGINS=https://memo.example.com

# ── 시드 데이터 (앱 첫 기동 시 자동 생성, 이미 있으면 건너뜀) ──
SEED_USERNAME=tester
SEED_PASSWORD=test1234!
SEED_DISPLAY_NAME=유형환
SEED_GITHUB_ID=여기에-깃허브-ID

# ── 배포 이미지 ──
# APP_IMAGE / IMAGE_TAG 는 여기에 적지 않음.
# 3단계 GitHub Actions 가 배포할 때 셸 환경변수로 넘기므로 서버의 .env 는 수정되지 않음.
